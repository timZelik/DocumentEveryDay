# Copy to .env (git-ignored) and fill in. scripts/run_on_mac.sh loads it.

# A freshly created Anthropic API key (console.anthropic.com). Never commit it or paste it in chat.
ANTHROPIC_API_KEY=

# The single secret for the upload/review pages. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DOCUMENTEVERYDAY_ACCESS_TOKEN=

# The HTTPS address `tailscale serve` prints, e.g. https://macbook.tail1234.ts.net
DOCUMENTEVERYDAY_PUBLIC_BASE_URL=

# ntfy topic: anyone who knows it can read the pushes, so make it random. Subscribe to it in the ntfy iPhone app.
#   python3 -c "import secrets; print('documenteveryday-' + secrets.token_hex(8))"
DOCUMENTEVERYDAY_NTFY_TOPIC=

# Optional knobs (defaults shown)
# DOCUMENTEVERYDAY_CLAUDE_MODEL=claude-haiku-5-5
# DOCUMENTEVERYDAY_BATCH_BUDGET_DOLLARS=0.50
# DOCUMENTEVERYDAY_WHISPER_MODEL=small            # multilingual, so Arabic stays Arabic
# DOCUMENTEVERYDAY_VIDEO_ENCODER=h264_videotoolbox  # Apple hardware encoder; libx264 elsewhere
# DOCUMENTEVERYDAY_RAW_FOOTAGE_RETENTION_DAYS=5
# DOCUMENTEVERYDAY_MAXIMUM_CLIPS_PER_BATCH=10
# DOCUMENTEVERYDAY_MINIMUM_CLIP_SCORE=5
# DOCUMENTEVERYDAY_DATA_DIRECTORY=./data
